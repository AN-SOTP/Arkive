<Window x:Class="Arkive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arkive"
        Icon="Assets/Arkive.ico"
        Width="1320"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="Open a copied or read-only UPK package to begin." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="ValidationToggleButton"
                        Content="Validation details"
                        Padding="8,2" Margin="0"
                        Click="ValidationToggleButton_Click"
                        ToolTip="Show or hide technical package validation messages." />
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="UpdateNotice" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}" Padding="12,8"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="InstallUpdateButton" Content="Install update and restart" Click="InstallUpdateButton_Click" />
                    <Button x:Name="CancelUpdateButton" Content="Cancel download" Visibility="Collapsed" Click="CancelUpdateButton_Click" />
                    <Button Content="Later" Click="DismissUpdateButton_Click" />
                </StackPanel>
                <TextBlock x:Name="UpdateNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="148"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,2"
                ClipToBounds="True">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                    <Setter Property="Padding" Value="11,6" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                </Style>
            </Border.Resources>
            <Grid Background="{DynamicResource BannerBackdropBrush}" ClipToBounds="True">
                <Rectangle Margin="-16,0,-16,0" Opacity="0.16"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="BannerBackdropArtworkBrush"
                                    Stretch="UniformToFill" TileMode="None"
                                    AlignmentX="Center" AlignmentY="Center"
                                    ViewboxUnits="RelativeToBoundingBox" />
                    </Rectangle.Fill>
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#8AFFFFFF" Offset="0" />
                            <GradientStop Color="#64FFFFFF" Offset="0.18" />
                            <GradientStop Color="#3AFFFFFF" Offset="0.34" />
                            <GradientStop Color="#18FFFFFF" Offset="0.50" />
                            <GradientStop Color="#00FFFFFF" Offset="0.66" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.Effect>
                        <BlurEffect Radius="20" RenderingBias="Performance" />
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="BannerArtworkSurface"
                           Width="760" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="BannerArtworkBrush"
                                    Stretch="Uniform" TileMode="None"
                                    AlignmentX="Left" AlignmentY="Center"
                                    ViewboxUnits="RelativeToBoundingBox" />
                    </Rectangle.Fill>
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#FFFFFFFF" Offset="0.14" />
                            <GradientStop Color="#F2FFFFFF" Offset="0.20" />
                            <GradientStop Color="#C8FFFFFF" Offset="0.28" />
                            <GradientStop Color="#78FFFFFF" Offset="0.36" />
                            <GradientStop Color="#2AFFFFFF" Offset="0.44" />
                            <GradientStop Color="#00FFFFFF" Offset="0.50" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Grid Margin="18,13,14,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Panel.ZIndex="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Effect>
                            <DropShadowEffect Color="#D0000000" BlurRadius="8"
                                              ShadowDepth="1" Opacity="0.85" />
                        </StackPanel.Effect>
                        <TextBlock Text="A R K I V E" TextAlignment="Center"
                                   Foreground="{DynamicResource HeaderTextBrush}"
                                   FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="LOST ARK MOD WORKBENCH" Margin="1,2,0,0"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource HeaderMutedTextBrush}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Panel.ZIndex="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right" MinWidth="520">
                        <StackPanel HorizontalAlignment="Right" Margin="0,0,0,9">
                            <TextBlock x:Name="PackageAliasText"
                                       HorizontalAlignment="Right" TextAlignment="Right"
                                       Foreground="{DynamicResource HeaderTextBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Text="Mod library" />
                            <TextBlock x:Name="PathText" Margin="0,3,0,0"
                                       MaxWidth="620" HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource HeaderMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Create, edit, and apply portable Lost Ark mods." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ReportProblemButton" Content="Report a problem" Click="ReportProblemButton_Click"
                                    ToolTip="Pack Arkive's recent logs, your mod list and the checks of the meshes you're editing into one file and copy it, ready to send. No game files or settings are included." />
                            <Button x:Name="AdvancedSectionsButton" Content="Advanced  ▾"
                                    Click="AdvancedSectionsButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Asset discovery">
                                        <MenuItem Header="Open package…" Click="OpenPackage_Click" />
                                        <MenuItem Header="Package assets" Tag="Assets" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Library and game setup" Tag="Library" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Characters and NPCs" Tag="Entities" Click="AdvancedNavigationMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Package internals">
                                        <MenuItem Header="Compressed chunks" Tag="CompressedChunks" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Index status" Tag="IndexStatus" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Diagnostics and logs" Tag="Diagnostics" Click="AdvancedNavigationMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Mod tools">
                                        <MenuItem Header="Package projects" Tag="PackageProjects" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Game update safety" Tag="GameSafety" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Conflicts and dependencies" Tag="ModDependencies" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Mod sets" Tag="ModSets" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Legacy mesh bundles" Tag="LegacyBundles" Click="AdvancedNavigationMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Native asset tools">
                                        <MenuItem Header="Texture reconnaissance" Tag="TextureRecon" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Skeletal mesh reconnaissance" Tag="MeshRecon" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Static meshes" Tag="StaticMeshes" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Materials" Tag="Materials" Click="AdvancedNavigationMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="Evidence and workspaces">
                                        <MenuItem Header="Exports" Tag="Exports" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Relationships" Tag="Relationships" Click="AdvancedNavigationMenuItem_Click" />
                                        <MenuItem Header="Baselines" Tag="Baselines" Click="AdvancedNavigationMenuItem_Click" />
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            </Button>
                            <Button Content="Settings" Click="AppearanceSettingsButton_Click" />
                            <Button x:Name="PackageActionsButton" Content="More  ···" Margin="0"
                                    Click="PackageActionsButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="InspectAssetButton"
                                              Header="Inspect selected asset in UModel"
                                              IsEnabled="False" Click="InspectAssetButton_Click" />
                                    <MenuItem x:Name="PreviewButton" Header="Browse whole package in UModel"
                                              IsEnabled="False" Click="PreviewButton_Click"
                                              ToolTip="UModel starts at its first supported object, not the selected row." />
                                    <MenuItem x:Name="ExportButton" Header="Export selected asset via UModel"
                                              IsEnabled="False" Click="ExportButton_Click" />
                                    <MenuItem x:Name="BaselineAssetButton" Header="Baseline selected asset"
                                              IsEnabled="False" Click="BaselineAssetButton_Click" />
                                    <Separator />
                                    <MenuItem Header="Open session logs" Click="OpenLogsButton_Click" />
                                    <MenuItem Header="Report a problem…" Click="ReportProblemButton_Click" />
                                    <MenuItem Header="About / licence" Click="AboutLicenseButton_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceContent" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ResultsRow" Height="*" MinHeight="300" />
                <RowDefinition x:Name="ValidationSplitterRow" Height="0" />
                <RowDefinition x:Name="ValidationRow" Height="0" />
            </Grid.RowDefinitions>
            <TabControl x:Name="MainTabControl" Grid.Row="0" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem x:Name="AssetsTab" Header="Assets" Visibility="Collapsed">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Border Padding="8,5"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="Important: Browse whole package cannot jump to the selected row. UModel starts at its first supported object, so the displayed class may be unrelated to your selection."
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Search this package" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="AssetFilterTextBox"
                                         Width="390"
                                         TextChanged="AssetFilterTextBox_TextChanged"
                                         ToolTip="All words must match across object/package fields and loaded localized game DB names, keys, entity types, or IDs. Prefix a word with - to exclude it." />
                                <Button Content="Clear"
                                        Margin="6,0,0,0"
                                        Click="ClearAssetFilterButton_Click" />
                                <ComboBox x:Name="AssetKindComboBox"
                                          Width="145"
                                          Margin="8,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="AssetKindComboBox_SelectionChanged"
                                          ToolTip="Filter by Arkive's broad asset category">
                                    <ComboBoxItem Content="All categories" Tag="" />
                                    <ComboBoxItem Content="Exportable resources" Tag="Exportable" />
                                    <ComboBoxItem Content="Textures" Tag="Texture" />
                                    <ComboBoxItem Content="Static meshes" Tag="StaticMesh" />
                                    <ComboBoxItem Content="Skeletal meshes" Tag="SkeletalMesh" />
                                    <ComboBoxItem Content="Materials" Tag="Material" />
                                    <ComboBoxItem Content="MaterialInstanceConstant" Tag="MaterialInstanceConstant" />
                                    <ComboBoxItem Content="Interface movies" Tag="InterfaceMovie" />
                                    <ComboBoxItem Content="Metadata only" Tag="Object" />
                                </ComboBox>
                                <Button x:Name="TextureReconButton"
                                        Content="Native texture recon"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="TextureReconButton_Click"
                                        ToolTip="Read the selected Texture2D from Arkive's logical package stream and create a bounded property/mip evidence report." />
                                <Button x:Name="SkeletalMeshReconButton"
                                        Content="Native mesh recon"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="SkeletalMeshReconButton_Click"
                                        ToolTip="Read the selected SkeletalMesh or StaticMesh export and independently prove its native LOD/render layout before editable GLB export." />
                                <Button x:Name="ExtractSkeletalMeshAssetKitButton"
                                        Content="Extract complete asset kit"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="ExtractSkeletalMeshAssetKitButton_Click"
                                        ToolTip="Export the selected SkeletalMesh as an editable GLB and collect its exact UModel material and Texture2D dependencies in one persistent folder. No mod project or game file is changed." />
                                <Button x:Name="MaterialReconButton"
                                        Content="Material editor"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="MaterialReconButton_Click"
                                        ToolTip="Decode the selected MaterialInstanceConstant and edit proven scalar/vector values, texture references, and its parent within the same UPK." />
                                <Button x:Name="AssetStartTextureModButton"
                                        Content="Start texture mod"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="AssetStartTextureModButton_Click"
                                        ToolTip="Create and open a normal editable image for the selected Texture2D. Arkive keeps the technical export evidence in the background." />
                                <TextBlock x:Name="AssetCountText"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Text="No catalogue loaded" />
                            </StackPanel>
                        </StackPanel>
                        <DataGrid x:Name="AssetsGrid"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="AssetsGrid_SelectionChanged"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding ExportIndex}" Width="60" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Kind}" Width="105" />
                                <DataGridTextColumn Header="Reported UE class" Binding="{Binding ClassName}" Width="180" />
                                <DataGridTextColumn Header="Reported object" Binding="{Binding ObjectPath}" Width="230" />
                                <DataGridTextColumn Header="In-game name" Binding="{Binding InGameNames}" Width="*" />
                                <DataGridTextColumn Header="Use" Binding="{Binding Capability}" Width="105" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="95" />
                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="LibraryTab" Header="Asset Library">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Expander x:Name="LibrarySetupExpander" Header="Library setup" Margin="0,0,0,6">
                                <StackPanel Margin="0,5,0,0">
                                    <Border Padding="8,5"
                                            Margin="0,0,0,6"
                                            Background="{DynamicResource InfoSurfaceBrush}"
                                            BorderBrush="{DynamicResource InfoBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="Build a resumable read-only catalogue for a Packages folder. Arkive stores aliases and object metadata in its local cache; source packages are never renamed or modified."
                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="Workers" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <ComboBox x:Name="LibraryWorkersComboBox"
                                                      Width="52"
                                                      SelectedIndex="2"
                                                      Margin="0,0,8,0"
                                                      ToolTip="Number of UModel package-list processes allowed at once. Four is recommended; reduce this on a slow disk.">
                                                <ComboBoxItem Content="1" Tag="1" />
                                                <ComboBoxItem Content="2" Tag="2" />
                                                <ComboBoxItem Content="4" Tag="4" />
                                                <ComboBoxItem Content="6" Tag="6" />
                                                <ComboBoxItem Content="8" Tag="8" />
                                            </ComboBox>
                                            <Button x:Name="LibraryBuildButton"
                                                    Content="Build / update index"
                                                    IsEnabled="False"
                                                    Click="LibraryBuildButton_Click" />
                                            <Button x:Name="LibraryCancelButton"
                                                    Content="Cancel"
                                                    IsEnabled="False"
                                                    Click="LibraryCancelButton_Click" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Left"
                                                Content="Choose Packages folder..."
                                                Click="ChooseLibraryFolderButton_Click" />
                                        <TextBox x:Name="LibraryRootTextBox"
                                                 Margin="6,0"
                                                 IsReadOnly="True"
                                                 Text="No library folder selected" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Choose fast scratch..."
                                                    Click="ChooseLibraryScratchButton_Click"
                                                    ToolTip="Use an empty folder on the same drive as Packages. Arkive creates temporary no-copy hard links so UModel does not scan all 33,000 files for every package." />
                                            <Button Content="Disable"
                                                    Click="DisableLibraryScratchButton_Click" />
                                        </StackPanel>
                                        <TextBox x:Name="LibraryScratchTextBox"
                                                 Margin="0,0,6,0"
                                                 IsReadOnly="True"
                                                 Text="Fast scratch: disabled" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="GameAssetLinksButton"
                                                    Content="Build verified asset links..."
                                                    IsEnabled="False"
                                                    Click="GameAssetLinksButton_Click"
                                                    ToolTip="Resolve the current in-game-name search—or all supported database-linked models when the search box is empty—through their meshes, materials, and textures. Results are cached in a compressed sidecar." />
                                            <Button x:Name="GameAssetLinksCancelButton"
                                                    Content="Cancel links"
                                                    IsEnabled="False"
                                                    Click="GameAssetLinksCancelButton_Click" />
                                            <ComboBox x:Name="GameDatabaseLanguageComboBox" Width="90" SelectedIndex="0"
                                                      Margin="6,0" ToolTip="Language used for in-game names in the database mapping.">
                                                <ComboBoxItem Content="English" />
                                                <ComboBoxItem Content="German" />
                                                <ComboBoxItem Content="French" />
                                                <ComboBoxItem Content="Spanish" />
                                            </ComboBox>
                                            <Button x:Name="BuildGameDatabaseButton" Content="Build game DB..."
                                                    Click="BuildGameDatabaseButton_Click"
                                                    ToolTip="Read your client's EFGame/data2.lpk and build the in-game-name mapping. All tools are included; game files stay unchanged." />
                                            <Button x:Name="LoadGameMetadataButton" Content="Load mapping..."
                                                    Click="LoadGameMetadataButton_Click"
                                                    ToolTip="Load an existing Arkive game-name metadata JSON instead of building one." />
                                        </StackPanel>
                                        <TextBlock x:Name="GameMetadataText"
                                                   VerticalAlignment="Center"
                                                   Text="Game DB mapping: not loaded"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel x:Name="GameDatabaseProgressPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                        <Button x:Name="GameDatabaseCancelButton" DockPanel.Dock="Right" Content="Cancel DB build"
                                                Click="GameDatabaseCancelButton_Click" />
                                        <StackPanel>
                                            <TextBlock x:Name="GameDatabaseProgressText" TextWrapping="Wrap" />
                                            <ProgressBar x:Name="GameDatabaseProgressBar" Height="8" Minimum="0" Maximum="1" Margin="0,4,6,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="LibraryProgressBar"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Value="0"
                                                 Margin="0,0,0,6" />
                                </StackPanel>
                            </Expander>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Search assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="LibrarySearchTextBox"
                                         Width="260"
                                         KeyDown="LibrarySearchTextBox_KeyDown"
                                         ToolTip="Search by package filename, object name, in-game name, or asset class. All words must match; prefix a word with - to exclude it." />
                                <Button x:Name="LibrarySearchButton" Content="Search"
                                        Margin="6,0,0,0"
                                        Click="LibrarySearchButton_Click" />
                                <Button Content="Clear"
                                        Margin="6,0,0,0"
                                        Click="ClearLibrarySearchButton_Click" />
                                <ComboBox x:Name="LibrarySearchScopeComboBox"
                                          Width="185"
                                          Margin="8,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="LibrarySearchOption_SelectionChanged"
                                          ToolTip="Choose which indexed fields the search text is allowed to match. In-game name requires the game DB mapping.">
                                    <ComboBoxItem Content="All names and filenames" Tag="AllFields" />
                                    <ComboBoxItem Content="In-game name only" Tag="InGameName" />
                                    <ComboBoxItem Content="Object name only" Tag="ObjectName" />
                                    <ComboBoxItem Content="Object + in-game name" Tag="ObjectAndInGameName" />
                                </ComboBox>
                                <ComboBox x:Name="LibraryKindComboBox"
                                          Width="145"
                                          Margin="8,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="LibrarySearchOption_SelectionChanged"
                                          ToolTip="Limit global results to an asset category">
                                    <ComboBoxItem Content="All categories" Tag="" />
                                    <ComboBoxItem Content="Textures" Tag="Texture" />
                                    <ComboBoxItem Content="Static meshes" Tag="StaticMesh" />
                                    <ComboBoxItem Content="Skeletal meshes" Tag="SkeletalMesh" />
                                    <ComboBoxItem Content="Materials" Tag="Material" />
                                    <ComboBoxItem Content="MaterialInstanceConstant" Tag="MaterialInstanceConstant" />
                                    <ComboBoxItem Content="Particle effects" Tag="ParticleSystem" />
                                    <ComboBoxItem Content="Interface movies" Tag="InterfaceMovie" />
                                    <ComboBoxItem Content="Sounds" Tag="Sound" />
                                    <ComboBoxItem Content="Metadata only" Tag="Object" />
                                </ComboBox>
                                <ComboBox x:Name="LibraryArchetypeComboBox"
                                          Width="185"
                                          Margin="8,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="LibrarySearchOption_SelectionChanged"
                                          ToolTip="Limit results to assets linked to a playable base archetype. Shared assets remain visible for every archetype that uses them.">
                                    <ComboBoxItem Content="All class types" Tag="" />
                                </ComboBox>
                                <TextBlock x:Name="LibraryCountText"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Text="No index loaded" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="LibrarySuggestButton"
                                        Content="Suggest in-game names"
                                        Click="LibrarySuggestButton_Click"
                                        ToolTip="Use the loaded game database to turn a partial name into qualified NPC, character, outfit, and item searches." />
                                <ComboBox x:Name="LibrarySortComboBox"
                                          Width="145"
                                          SelectedIndex="0"
                                          SelectionChanged="LibrarySearchOption_SelectionChanged"
                                          ToolTip="Relevance prefers exact and token-prefix matches and stronger database evidence.">
                                    <ComboBoxItem Content="Sort: relevance" Tag="Relevance" />
                                    <ComboBoxItem Content="Sort: package" Tag="Package" />
                                    <ComboBoxItem Content="Sort: object" Tag="Object" />
                                    <ComboBoxItem Content="Sort: largest" Tag="Size" />
                                </ComboBox>
                                <CheckBox x:Name="LibraryLinkedOnlyCheckBox"
                                          Content="Database-linked only"
                                          Margin="9,0,8,0"
                                          VerticalAlignment="Center"
                                          Click="LibrarySearchOption_Click"
                                          ToolTip="Hide purely technical name matches that have no in-game database association." />
                                <Button x:Name="LibraryPreviewButton"
                                        Content="Preview"
                                        IsEnabled="False"
                                        Click="LibraryPreviewButton_Click"
                                        ToolTip="Open the selected mesh in Arkive's Asset Viewer (every LOD, game colours, materials, textures and UModel's object properties), or the selected texture in the Texture Viewer with the parts the game's interface names on it. You can also double-click a mesh result." />
                                <Button x:Name="LibraryInspectButton"
                                        Content="Inspect selected in UModel"
                                        IsEnabled="False"
                                        Click="LibraryInspectButton_Click"
                                        ToolTip="Ask UModel to open the selected indexed object. You can also double-click a result; UModel will decide whether that object type can be displayed." />
                                <Button x:Name="LibraryBrowsePackageButton"
                                        Content="Browse package"
                                        IsEnabled="False"
                                        Click="LibraryBrowsePackageButton_Click"
                                        ToolTip="Open the selected result's whole package in UModel." />
                                <Button x:Name="LibraryOpenPackageFolderButton"
                                        Content="Open package folder"
                                        IsEnabled="False"
                                        Click="LibraryOpenPackageFolderButton_Click" />
                                <Button x:Name="LibraryCopyIdentityButton"
                                        Content="Copy asset identity"
                                        IsEnabled="False"
                                        Click="LibraryCopyIdentityButton_Click"
                                        ToolTip="Copy the decoded package, physical package, class, object, and export index." />
                            </WrapPanel>
                            <Expander x:Name="LibraryDiscoveryExpander"
                                      Header="Discovery suggestions and result facets"
                                      IsExpanded="False"
                                      Margin="0,6,0,0">
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="300" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" MinWidth="220" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid x:Name="LibrarySuggestionsGrid"
                                              Height="116"
                                              IsReadOnly="True"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              SelectionMode="Single"
                                              MouseDoubleClick="LibrarySuggestionsGrid_MouseDoubleClick"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Suggested name" Binding="{Binding QualifiedDisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="125" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Hint}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7,4">
                                        <StackPanel>
                                            <TextBlock Text="Current result breakdown" FontWeight="SemiBold" />
                                            <TextBlock x:Name="LibraryFacetText"
                                                       Margin="0,4,0,0"
                                                       Text="Search to see category, class-type, and evidence counts."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Expander>
                        </StackPanel>
                        <Border x:Name="LibraryZonePanel"
                                DockPanel.Dock="Top"
                                Visibility="Collapsed"
                                Margin="0,0,0,6"
                                Padding="8,6"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LibraryZoneHeaderText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <ItemsControl x:Name="LibraryZoneCards">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LibraryZoneCard_Click"
                                                    Margin="0,0,8,4"
                                                    Padding="10,6"
                                                    MinWidth="220"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip="{Binding Tip}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Action}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="LibraryGrid"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  SelectionMode="Single"
                                  SelectionChanged="LibraryGrid_SelectionChanged"
                                  MouseDoubleClick="LibraryGrid_MouseDoubleClick"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Inspect selected in UModel" Click="LibraryInspectButton_Click" />
                                    <MenuItem Header="Browse package in UModel" Click="LibraryBrowsePackageButton_Click" />
                                    <Separator />
                                    <MenuItem x:Name="LibraryExportButton" Header="Export selected" Click="LibraryExportButton_Click"
                                              ToolTip="Export this texture, mesh, or material into an isolated Arkive export workspace session." />
                                    <MenuItem x:Name="LibraryExploreRelationshipsButton" Header="Explore relationships"
                                              Click="LibraryExploreRelationshipsButton_Click" />
                                    <MenuItem x:Name="LibraryBaselineButton" Header="Create asset baseline" Click="LibraryBaselineButton_Click" />
                                    <MenuItem x:Name="LibraryTextureReconButton" Header="Run native texture reconnaissance"
                                              Click="LibraryTextureReconButton_Click" />
                                    <MenuItem x:Name="LibrarySkeletalMeshReconButton" Header="Run native mesh reconnaissance"
                                              Click="LibrarySkeletalMeshReconButton_Click" />
                                    <Separator />
                                    <MenuItem Header="Open package folder" Click="LibraryOpenPackageFolderButton_Click" />
                                    <MenuItem Header="Copy asset identity" Click="LibraryCopyIdentityButton_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Decoded filename" Binding="{Binding PackageAlias}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="Physical package" Binding="{Binding PhysicalPackageName}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" />
                                <DataGridTextColumn Header="Reported UE class" Binding="{Binding ClassName}" Width="*" MinWidth="125" />
                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="2*" MinWidth="160" />
                                <DataGridTextColumn Header="In-game name" Binding="{Binding InGameNames}" Width="2*" MinWidth="160" />
                                <DataGridTextColumn Header="Link" Binding="{Binding LinkEvidence}" Width="115" />
                                <DataGridTextColumn Header="Why matched" Binding="{Binding MatchReason}" Width="*" MinWidth="125" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="CreateModTab" Header="Create Mod">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Create a mod" FontSize="20" Margin="0,0,0,8" />
                            <TextBlock Text="Give your mod a name, then add and modify its assets in Edit mods. A draft is saved locally; game files stay unchanged until you apply the saved mod."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Mod name" Margin="0,0,0,4" />
                                    <TextBox x:Name="CreateModNameTextBox" KeyDown="CreateModTextBox_KeyDown" TextChanged="CreateModNameTextBox_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Version" Margin="0,0,0,4" />
                                    <TextBox x:Name="CreateModVersionTextBox" Text="1.0.0" KeyDown="CreateModTextBox_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Author (optional)" Margin="0,0,0,4" />
                                    <TextBox x:Name="CreateModAuthorTextBox" KeyDown="CreateModTextBox_KeyDown" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Description (optional)" Margin="0,0,0,4" />
                            <TextBox x:Name="CreateModDescriptionTextBox" MinHeight="75" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <Button x:Name="CreateModButton" Content="Create mod" HorizontalAlignment="Left" Margin="0,16,0,8"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="CreateModButton_Click" />
                            <TextBlock x:Name="CreateModStatusText" Text="After creation, add individual assets or a complete mesh asset kit."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WorkshopTab" Header="Edit Mods">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <WrapPanel>
                                <ComboBox x:Name="AuthoringModComboBox" Width="280" DisplayMemberPath="DisplayName"
                                          SelectionChanged="AuthoringModComboBox_SelectionChanged" />
                                <Button x:Name="AuthoringNewButton" Content="New mod" Click="NewModButton_Click" />
                                <Button x:Name="AuthoringSaveButton" Content="Save mod" Click="AuthoringSaveButton_Click" />
                                <Button x:Name="AuthoringApplyButton" Content="Save and apply" Click="AuthoringApplyButton_Click" />
                                <Button x:Name="AuthoringPreviewChangesButton" Content="Preview changes" Click="AuthoringPreviewChangesButton_Click" />
                                <Button x:Name="AuthoringShareButton" Content="Share…" Click="AuthoringShareButton_Click" />
                            </WrapPanel>
                            <Expander x:Name="AuthoringMetadataExpander" Header="Mod details" Margin="0,5,0,5">
                                <StackPanel>
                                    <Grid Margin="0,5,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Mod name" Margin="0,0,0,4" />
                                            <TextBox x:Name="AuthoringNameTextBox" TextChanged="AuthoringMetadata_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Version" Margin="0,0,0,4" />
                                            <TextBox x:Name="AuthoringVersionTextBox" TextChanged="AuthoringMetadata_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Author" Margin="0,0,0,4" />
                                            <TextBox x:Name="AuthoringAuthorTextBox" TextChanged="AuthoringMetadata_Changed" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Description" Margin="0,0,0,4" />
                                    <TextBox x:Name="AuthoringDescriptionTextBox" MinHeight="55" AcceptsReturn="True"
                                             TextWrapping="Wrap" TextChanged="AuthoringMetadata_Changed" />
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="AuthoringStatusText" Text="Choose a mod to edit, or use Create mod to start a new one." TextWrapping="Wrap" />
                            <Border x:Name="AuthoringOperationPanel" Visibility="Collapsed" Margin="0,5,0,0" Padding="6"
                                    Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="AuthoringCancelButton" DockPanel.Dock="Right" Content="Cancel extraction" Click="AuthoringCancelButton_Click" />
                                    <StackPanel>
                                        <TextBlock x:Name="AuthoringOperationText" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <ProgressBar x:Name="AuthoringOperationProgress" Height="6" Minimum="0" Maximum="1" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <Grid x:Name="AuthoringPaneGrid" SizeChanged="WorkflowPaneGrid_SizeChanged" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="AuthoringAssetsRow" Height="*" MinHeight="125" />
                                <RowDefinition x:Name="AuthoringSplitterRow" Height="0" />
                                <RowDefinition x:Name="AuthoringSearchRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Expander x:Name="AuthoringSearchExpander" Grid.Row="2" Header="Add assets"
                                      Expanded="AuthoringSearchExpander_Expanded" Collapsed="AuthoringSearchExpander_Collapsed">
                                <DockPanel Margin="0,7,0,0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <WrapPanel>
                                            <TextBox x:Name="WorkshopSearchTextBox" Width="220" KeyDown="AuthoringSearchTextBox_KeyDown"
                                                     ToolTip="Search by an in-game name or object name." />
                                            <Button Content="Search" Click="WorkshopSearchButton_Click" />
                                            <Button Content="Suggest names" Click="WorkshopSuggestButton_Click" />
                                            <Grid x:Name="WorkshopSuggestionsPanel" Width="160" Visibility="Collapsed" Margin="0,0,8,0">
                                                <ComboBox x:Name="WorkshopSuggestionComboBox" DisplayMemberPath="QualifiedDisplayName"
                                                          Margin="0" ToolTip="Choose a suggested in-game name"
                                                          SelectionChanged="WorkshopSuggestionComboBox_SelectionChanged" />
                                                <TextBlock Text="Suggested names…" Margin="8,0,26,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=WorkshopSuggestionComboBox}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <!-- Filled from AssetTypes.Moddable by InitializeWorkshopKinds. -->
                                            <ComboBox x:Name="WorkshopKindComboBox" Width="170" />
                                            <ComboBox x:Name="WorkshopArchetypeComboBox" Width="145" SelectedIndex="0">
                                                <ComboBoxItem Content="All class types" Tag="" />
                                            </ComboBox>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,5,0,3">
                                            <Button x:Name="WorkshopBeginButton" Content="Add asset only" Click="WorkshopBeginButton_Click"
                                                    ToolTip="Create one editable working copy in this mod: GLB for a mesh, PNG/DDS for a texture, or a material parameter project. Dependencies are not added." />
                                            <Button x:Name="WorkshopExtractAssetKitButton" Content="Add mesh + textures/materials"
                                                    Click="WorkshopExtractAssetKitButton_Click"
                                                    ToolTip="Add the editable skeletal mesh, export its exact dependency kit, and prepare linked texture/material working copies as optional references. References are excluded until you tick Include; the game is not changed." />
                                            <Button x:Name="WorkshopPreviewButton" Content="Preview original" Click="WorkshopPreviewButton_Click"
                                                    ToolTip="Open the selected mesh in Arkive's Asset Viewer. Textures and materials open in UModel." />
                                            <Button x:Name="WorkshopUmodelButton" Content="Open in UModel" Click="WorkshopUmodelButton_Click"
                                                    ToolTip="Ask UModel to open the selected asset instead." />
                                        </WrapPanel>
                                        <TextBlock x:Name="WorkshopAddHelpText" Text="Asset only creates one working copy. Full kit also prepares the mesh's linked textures and materials."
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock x:Name="WorkshopStatusText" Text="" TextWrapping="Wrap" Margin="0,0,0,5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <DataGrid x:Name="WorkshopSearchResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserResizeColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                              SelectionChanged="WorkshopSearchResultsGrid_SelectionChanged"
                                              MouseDoubleClick="WorkshopSearchResultsGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="In-game name" Binding="{Binding InGameNames}" Width="2*" MinWidth="150" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" />
                                            <DataGridTextColumn Header="Asset" Binding="{Binding ObjectName}" Width="2*" MinWidth="180" />
                                            <DataGridTextColumn Header="Package" Binding="{Binding PackageAlias}" Width="*" MinWidth="130" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding LinkEvidence}" Width="*" MinWidth="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Expander>
                            <GridSplitter x:Name="AuthoringPaneSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          ShowsPreview="True" Visibility="Collapsed" DragCompleted="WorkflowPaneSplitter_DragCompleted"
                                          ToolTip="Drag to resize working assets and search results. Arrow keys also resize the panes." />
                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <WrapPanel>
                                        <Button x:Name="AuthoringPrepareButton" Content="Prepare for editing" Click="AuthoringPrepareButton_Click" />
                                        <Button x:Name="AuthoringOpenButton" Content="Open edited file" Click="AuthoringOpenButton_Click" />
                                        <Button x:Name="AuthoringColoursButton" Content="Edit colours" Click="AuthoringColoursButton_Click"
                                                ToolTip="Open the selected texture in Arkive's Texture Viewer to recolour it, or one named part of an interface picture (such as the HP bar), and save it to the working file." />
                                        <Button x:Name="AuthoringRecolourButton" Content="Recolour…" Click="AuthoringRecolourButton_Click"
                                                ToolTip="Recolour every selected picture, material and effect at once with one colour choice, with a before-and-after preview. With nothing selected, it recolours the whole mod." />
                                        <Button x:Name="AuthoringProportionsButton" Content="Edit in proportion editor" Visibility="Collapsed"
                                                Click="AuthoringProportionsButton_Click"
                                                ToolTip="Reopen this Simple upscale mod's outfit from the clean game files with the mod's sliders; saving there updates this mod." />
                                        <Button x:Name="AuthoringReplaceButton" Content="Replace file…" Click="AuthoringReplaceButton_Click" />
                                        <Button x:Name="AuthoringCompareButton" Content="Compare with original" Click="AuthoringCompareButton_Click" />
                                        <Button x:Name="AuthoringViewButton" Content="Preview with edits" Click="AuthoringViewButton_Click"
                                                ToolTip="Open the selected mesh (or the mod's first mesh, or the model its textures belong to) in Arkive's Asset Viewer with this mod's edited mesh, textures and material values, also on the skills it plays. The view refreshes when you save a working file." />
                                        <Button x:Name="AuthoringPreviewButton" Content="Preview original" Click="AuthoringPreviewButton_Click" />
                                        <Button x:Name="AuthoringFolderButton" Content="Working folder" Click="AuthoringFolderButton_Click" />
                                        <Button x:Name="AuthoringRemoveButton" Content="Remove selected assets" Click="AuthoringRemoveButton_Click"
                                                ToolTip="Remove every selected asset from this draft. Use Ctrl-click or Shift-click to select several rows, or Ctrl+A to select all. Working files are kept." />
                                    </WrapPanel>
                                    <TextBlock x:Name="AuthoringSummaryText" Text="Include the assets you want this mod to replace."
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                    <Border x:Name="AuthoringCheckPanel" Visibility="Collapsed" Margin="0,6,0,0" Padding="8,6"
                                            Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="AuthoringCheckText" TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <DataGrid x:Name="AuthoringAssetsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserResizeColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                          SelectionChanged="AuthoringAssetsGrid_SelectionChanged"
                                          MouseDoubleClick="AuthoringAssetsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Include" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Included, Mode=OneWay}" Click="AuthoringIncludeCheckBox_Click"
                                                              IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="155" />
                                        <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="180" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="155" />
                                        <DataGridTextColumn Header="Working file" Binding="{Binding WorkingFile}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="BodyProportionsTab" Header="Simple Upscale">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Simple upscale" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Text="Reshape a player outfit or a supported NPC: search, open it in the proportion editor, move the sliders and save the result as a mod. Only player bodies and outfit pieces, and the NPCs Brelshaza, Echidna, Nineveh, Serca and Beatrice, are listed here; faces, hair, headwear, weapons, other NPCs and objects are left out." />
                            <WrapPanel>
                                <TextBox x:Name="ProportionSearchTextBox" Width="240" KeyDown="ProportionSearchTextBox_KeyDown"
                                         ToolTip="An outfit's or NPC's in-game name, or part of an object name, for example pc_wr_f_av, 226a or Echidna." />
                                <Button Content="Search" Click="ProportionSearchButton_Click" />
                                <ComboBox x:Name="ProportionBodyComboBox" Width="250" SelectionChanged="ProportionBodyComboBox_SelectionChanged"
                                          ToolTip="Show only one base body" />
                                <CheckBox x:Name="ProportionWholeOutfitCheckBox" Content="Open the whole outfit" IsChecked="True"
                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                          ToolTip="Also open the outfit's other pieces (top, bottom, arms…), so they are reshaped together and keep meeting at their seams." />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="ProportionOpenButton" Content="Open in proportion editor" IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="ProportionOpenButton_Click" />
                                <Button x:Name="ProportionPreviewButton" Content="Preview original" IsEnabled="False" Click="ProportionPreviewButton_Click" />
                                <TextBlock Text="Preset" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <ComboBox x:Name="ProportionPresetComboBox" Width="220" VerticalAlignment="Center"
                                          SelectionChanged="ProportionPresetComboBox_SelectionChanged"
                                          DropDownOpened="ProportionPresetComboBox_DropDownOpened"
                                          ToolTip="Presets saved in the proportion editor for the selected body." />
                                <Button x:Name="ProportionApplyPresetButton" Content="Apply preset to selected outfits" IsEnabled="False"
                                        Click="ProportionApplyPresetButton_Click"
                                        ToolTip="Reshape every selected outfit (and, with Open the whole outfit, its other pieces) with the chosen preset and save them all as one new mod." />
                                <Button x:Name="ProportionApplyBodyButton" Content="Apply preset to every outfit of its body" IsEnabled="False"
                                        Click="ProportionApplyBodyButton_Click"
                                        ToolTip="Reshape every player outfit of the preset's body (for example every Female Warrior outfit) with the chosen preset and save them all as one new mod. This takes a long time; Arkive asks first." />
                                <Button x:Name="ProportionCancelButton" Content="Stop" Visibility="Collapsed"
                                        Click="ProportionCancelButton_Click"
                                        ToolTip="Stop after the piece being reshaped. The pieces done so far stay in a draft in Edit mods." />
                            </WrapPanel>
                            <TextBlock x:Name="ProportionStatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Search for a player outfit or one of the supported NPCs to begin." />
                            <Grid x:Name="ProportionProgressPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProportionProgressText" Grid.ColumnSpan="2" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <ProgressBar x:Name="ProportionProgressBar" Grid.Row="1" Height="10" Minimum="0" Maximum="1" Margin="0,4,8,0" />
                                <TextBlock x:Name="ProportionProgressPercent" Grid.Row="1" Grid.Column="1" MinWidth="36"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />
                            </Grid>
                        </StackPanel>
                        <DataGrid x:Name="ProportionResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserResizeColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                  SelectionChanged="ProportionResultsGrid_SelectionChanged"
                                  MouseDoubleClick="ProportionResultsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Body" Binding="{Binding Body}" Width="210" />
                                <DataGridTextColumn Header="Piece" Binding="{Binding Piece}" Width="90" />
                                <DataGridTextColumn Header="In-game name" Binding="{Binding Row.InGameNames}" Width="2*" MinWidth="150" />
                                <DataGridTextColumn Header="Asset" Binding="{Binding Row.ObjectName}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn Header="Package" Binding="{Binding Row.PackageAlias}" Width="*" MinWidth="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="OutfitSwapTab" Header="Outfit Swap">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Outfit swap" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Text="Wear any player outfit in place of another, on any body: Arkive fits the outfit to the other body's skeleton and shape (learned from the costumes the game makes for both), keeps it off the skin, and paints it into the replaced outfit's own pictures and materials. Find the outfit to wear on the left and the outfit it replaces on the right, then preview the swap and save it as a mod." />
                            <WrapPanel>
                                <Button x:Name="OutfitSwapPreviewButton" Content="Preview swap…" IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OutfitSwapPreviewButton_Click"
                                        ToolTip="Fit the chosen outfit onto the other one and show it in the viewer, with animations. Nothing is saved until you choose Save as mod there." />
                                <CheckBox x:Name="OutfitSwapOwnMaterialsCheckBox" Content="Keep the outfit's own materials (experimental)"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="Draw the outfit with its own game materials, exactly as on its own body (sheen, see-through cloth and glow included), instead of painting it into the replaced outfit's pictures. The mod then makes the replaced outfit's package use the other outfit's materials, so that outfit's package must stay in the game." />
                                <TextBlock x:Name="OutfitSwapChoiceText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                                           Text="Choose an outfit to wear on the left and the outfit it replaces on the right." />
                            </WrapPanel>
                            <TextBlock x:Name="OutfitSwapStatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Search for outfits by their in-game name or object name." />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Outfit to wear" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="OutfitSwapWearSearchTextBox" Width="240" KeyDown="OutfitSwapWearSearchTextBox_KeyDown"
                                             ToolTip="An outfit's in-game name, or part of an object name, for example 4th Anniversary or pc_dl_av_217." />
                                    <Button Content="Search" Click="OutfitSwapWearSearchButton_Click" />
                                    <ComboBox x:Name="OutfitSwapWearClassBox" Width="190" Margin="8,0,0,0"
                                              SelectionChanged="OutfitSwapClassBox_SelectionChanged"
                                              ToolTip="Show only outfits this class can wear: its own skins and the outfits of its body." />
                                </WrapPanel>
                                <DataGrid x:Name="OutfitSwapWearGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OutfitSwapGrid_SelectionChanged"
                                          PreviewMouseRightButtonDown="OutfitSwapGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Preview in Asset Viewer" Click="OutfitSwapPreviewInViewer_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Body" Width="190" SortMemberPath="Body">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Body}" ToolTip="{Binding Body}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Padding="2,0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Pieces" Binding="{Binding Parts}" Width="100" />
                                        <DataGridTextColumn Header="In-game name" Binding="{Binding InGameNames}" Width="2*" MinWidth="140" />
                                        <DataGridTextColumn Header="Outfit" Binding="{Binding Stem}" Width="*" MinWidth="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Outfit to replace" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="OutfitSwapReplaceSearchTextBox" Width="240" KeyDown="OutfitSwapReplaceSearchTextBox_KeyDown"
                                             ToolTip="The outfit your character wears that should show the other outfit instead, for example Cold Fury or pc_wbk_f_hr." />
                                    <Button Content="Search" Click="OutfitSwapReplaceSearchButton_Click" />
                                    <ComboBox x:Name="OutfitSwapReplaceClassBox" Width="190" Margin="8,0,0,0"
                                              SelectionChanged="OutfitSwapClassBox_SelectionChanged"
                                              ToolTip="Show only outfits this class can wear: its own skins and the outfits of its body." />
                                </WrapPanel>
                                <DataGrid x:Name="OutfitSwapReplaceGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OutfitSwapGrid_SelectionChanged"
                                          PreviewMouseRightButtonDown="OutfitSwapGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Preview in Asset Viewer" Click="OutfitSwapPreviewInViewer_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Body" Width="190" SortMemberPath="Body">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Body}" ToolTip="{Binding Body}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Padding="2,0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Pieces" Binding="{Binding Parts}" Width="100" />
                                        <DataGridTextColumn Header="In-game name" Binding="{Binding InGameNames}" Width="2*" MinWidth="140" />
                                        <DataGridTextColumn Header="Outfit" Binding="{Binding Stem}" Width="*" MinWidth="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="SoundsTab" Header="Sounds">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Sounds" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Text="Listen to the game's sound effects, voices and music, and replace single clips with your own audio. Sounds go by the developers' names, so Kazeros is kazeroth and Thaemine is kamen; Western boss names are translated for you. Replacing changes the game's audio files directly (close Lost Ark first), and Restore puts the original back." />
                            <WrapPanel>
                                <TextBox x:Name="SoundSearchTextBox" Width="280" KeyDown="SoundSearchTextBox_KeyDown"
                                         ToolTip="Part of a sound's name, for example kazeros battle, bgm login, or tyranno walk. Every word must appear." />
                                <Button Content="Search" Click="SoundSearchButton_Click" />
                                <ComboBox x:Name="SoundKindComboBox" Width="170" SelectedIndex="0"
                                          SelectionChanged="SoundKindComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All sounds" Tag="all" />
                                    <ComboBoxItem Content="Music only" Tag="music" />
                                    <ComboBoxItem Content="Sound effects and voices" Tag="effects" />
                                    <ComboBoxItem Content="Replaced by you" Tag="replaced" />
                                </ComboBox>
                                <Button x:Name="SoundOpenButton" Content="Listen and replace…" IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="SoundOpenButton_Click"
                                        ToolTip="Open the selected sound to play its clips and replace or restore them." />
                                <Button x:Name="SoundRestoreAllButton" Content="Restore all sounds" Click="SoundRestoreAllButton_Click"
                                        ToolTip="Put the game's original audio back for every clip you replaced." />
                            </WrapPanel>
                            <TextBlock x:Name="SoundStatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Search for a sound to begin. The first search reads the game's sound banks, which takes a few seconds." />
                        </StackPanel>
                        <DataGrid x:Name="SoundResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserResizeColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectionChanged="SoundResultsGrid_SelectionChanged"
                                  MouseDoubleClick="SoundResultsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sound" Binding="{Binding Name}" Width="3*" MinWidth="220" />
                                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="130" />
                                <DataGridTextColumn Header="Clips" Binding="{Binding ClipCount}" Width="55" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                                <DataGridTextColumn Header="Set" Binding="{Binding Set}" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="LoginScreenTab" Header="Login Screen">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Login screen" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Text="Choose the screen behind the login and server select menus. The game always shows its current update's screen, so Arkive plays the one you choose in its place, with that screen's own music and ambience. It shows the next time you start Lost Ark; close the game before changing it." />
                            <Border Padding="10,7" Background="{DynamicResource InfoSurfaceBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="Your game shows" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="LoginScreenLiveBox" Width="220"
                                              SelectionChanged="LoginScreenLiveBox_SelectionChanged"
                                              ToolTip="The screen this game update shows on its own. Arkive puts your choice in its place." />
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Change this only when a game update brings a new screen." />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LoginScreenUseButton" Content="Use this screen" MinWidth="150" IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="LoginScreenUseButton_Click" />
                                    <Button x:Name="LoginScreenRestoreButton" Content="Back to the game's own" Margin="8,0,0,0"
                                            Click="LoginScreenRestoreButton_Click"
                                            ToolTip="Puts the game's own video and sounds back exactly as they were." />
                                </StackPanel>
                                <TextBlock x:Name="LoginScreenStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Pick a screen to use." />
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="LoginScreenList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LoginScreenList_SelectionChanged" MouseDoubleClick="LoginScreenList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Margin="4" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel>
                                            <Grid Height="128" Background="{DynamicResource SurfaceAltBrush}">
                                                <TextBlock Text="{Binding PreviewNote}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                    <Border Padding="7,2" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                                                            Visibility="{Binding InUseVisibility}">
                                                        <TextBlock Text="In use" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                    <Border Padding="7,2" Margin="4,0,0,0" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                                                            Visibility="{Binding LiveVisibility}">
                                                        <TextBlock Text="Game's own" FontSize="12" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="12,8,12,10">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="FontsTab" Header="Fonts">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Fonts" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Choose the fonts the game uses for its text. Pick a TrueType font (.ttf) for each kind of text you want to change, then apply. They show the next time you start Lost Ark; close the game before applying. A font without some letters of your language shows blanks for them." />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="FontApplyButton" Content="Apply fonts" MinWidth="150" IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="FontApplyButton_Click" />
                                    <Button x:Name="FontRestoreButton" Content="Back to the game's own" Margin="8,0,0,0" IsEnabled="False"
                                            Click="FontRestoreButton_Click"
                                            ToolTip="Puts the game's own font.lpk back exactly as it was." />
                                </StackPanel>
                                <TextBlock x:Name="FontStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Choose a font for any kind of text." />
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FontSlotList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource SurfaceBrush}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <Button Content="Choose font…" MinWidth="120" Click="FontChooseButton_Click" />
                                                    <Button Content="{Binding ResetLabel}" MinWidth="120" Margin="8,0,0,0"
                                                            IsEnabled="{Binding Chosen}" Click="FontResetButton_Click" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Choice}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                                    <Border Margin="0,8,0,0" Padding="10,6" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4">
                                                        <TextBlock Text="{Binding Sample}" FontSize="22" TextTrimming="CharacterEllipsis"
                                                                   FontFamily="{Binding Preview, TargetNullValue={x:Static SystemFonts.MessageFontFamily}}" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="LanguageTab" Header="Language">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Game language" FontSize="20" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Text="Choose the language of the game's text. Arkive writes the chosen language's lines in place of the English ones; any line without a translation stays in English. Voices are not changed. It shows the next time you start Lost Ark; close the game before changing it." />
                            <Border Padding="10,7" Background="{DynamicResource InfoSurfaceBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="LanguageSavedText" TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}"
                                           Text="Arkive keeps a copy of every translation the game ships, so a language the game removes can still be used." />
                            </Border>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LanguageUseButton" Content="Use this language" MinWidth="150" IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="LanguageUseButton_Click" />
                                    <Button x:Name="LanguageRestoreButton" Content="Back to English" Margin="8,0,0,0" IsEnabled="False"
                                            Click="LanguageRestoreButton_Click"
                                            ToolTip="Puts the game's own text back exactly as it was." />
                                </StackPanel>
                                <TextBlock x:Name="LanguageStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Pick a language to use." />
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="LanguageList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LanguageList_SelectionChanged" MouseDoubleClick="LanguageList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Margin="4" Padding="12,10" CornerRadius="6" BorderThickness="1" VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Padding="7,2" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding InUseVisibility}" VerticalAlignment="Center">
                                                    <TextBlock Text="In use" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Height="6" Minimum="0" Maximum="1" Margin="0,8,0,0" Value="{Binding Coverage, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="EntityBrowserTab" Header="Characters &amp; NPCs" Visibility="Collapsed">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                            <Border Padding="8,6"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource InfoSurfaceBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="Browse playable classes, character-creation options, vendors, story NPCs, and combat entities from the loaded game databases. Direct DB links are authoritative; appearance-package and customization mappings remain clearly labelled until verified in game."
                                           Foreground="{DynamicResource InfoTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Refresh entities"
                                            Click="EntityBrowserRefreshButton_Click" />
                                    <Button x:Name="EntityBrowserCancelButton"
                                            Content="Cancel"
                                            IsEnabled="False"
                                            Click="EntityBrowserCancelButton_Click" />
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="Find character or NPC"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBox x:Name="EntityBrowserSearchTextBox"
                                             Width="285"
                                             TextChanged="EntityBrowserFilter_Changed"
                                             ToolTip="Search localized name, name key, category, type, database ID, details, or primary asset reference." />
                                    <ComboBox x:Name="EntityBrowserKindComboBox"
                                              Width="175"
                                              Margin="8,0,0,0"
                                              SelectedIndex="0"
                                              SelectionChanged="EntityBrowserFilter_Changed">
                                        <ComboBoxItem Content="Characters and NPCs" Tag="" />
                                        <ComboBoxItem Content="Playable characters" Tag="PlayableCharacter" />
                                        <ComboBoxItem Content="NPCs" Tag="Npc" />
                                        <ComboBoxItem Content="Functional NPCs / vendors" Tag="Functional" />
                                        <ComboBoxItem Content="Combat NPCs" Tag="Combat" />
                                    </ComboBox>
                                    <TextBlock x:Name="EntityBrowserSummaryText"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Text="Load the game DB mapping to populate this browser." />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" MinHeight="150" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="4*" MinHeight="210" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="EntityBrowserEntitiesGrid"
                                      Grid.Row="0"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      SelectionMode="Single"
                                      SelectionChanged="EntityBrowserEntitiesGrid_SelectionChanged"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="In-game name" Binding="{Binding DisplayName}" Width="220" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="125" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="155" />
                                    <DataGridTextColumn Header="DB ID" Binding="{Binding EntityId}" Width="90" />
                                    <DataGridTextColumn Header="Name key" Binding="{Binding NameKey}" Width="190" />
                                    <DataGridTextColumn Header="Primary look / model" Binding="{Binding PrimaryAssetReference}" Width="250" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="1"
                                          Height="7"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext"
                                          Background="{DynamicResource DividerBrush}"
                                          Cursor="SizeNS" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="320" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="3*" MinWidth="430" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="Ordered character customization" Padding="5">
                                    <DockPanel>
                                        <TextBlock x:Name="EntityBrowserCustomizationSummaryText"
                                                   DockPanel.Dock="Top"
                                                   Margin="0,0,0,5"
                                                   Text="Select a playable character to see inherited customization records."
                                                   TextWrapping="Wrap" />
                                        <DataGrid x:Name="EntityBrowserCustomizationGrid"
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserResizeColumns="True"
                                                  SelectionMode="Single"
                                                  SelectionChanged="EntityBrowserCustomizationGrid_SelectionChanged"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="125" />
                                                <DataGridTextColumn Header="UI #" Binding="{Binding UiPosition}" Width="55" />
                                                <DataGridTextColumn Header="Unit" Binding="{Binding ObjectUnit}" Width="55" />
                                                <DataGridTextColumn Header="Candidate assets" Binding="{Binding CandidateAssets}" Width="220" />
                                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </GroupBox>
                                <GridSplitter Grid.Column="1"
                                              Width="7"
                                              HorizontalAlignment="Stretch"
                                              ResizeDirection="Columns"
                                              ResizeBehavior="PreviousAndNext"
                                              Background="{DynamicResource DividerBrush}"
                                              Cursor="SizeWE" />
                                <GroupBox Grid.Column="2" Header="Linked and candidate assets" Padding="5">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                            <TextBlock x:Name="EntityBrowserAssetSummaryText"
                                                       Text="Select an entity to resolve its indexed assets."
                                                       TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,5,0,0">
                                                <Button x:Name="EntityBrowserInspectAssetButton"
                                                        Content="Inspect in UModel"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserInspectAssetButton_Click" />
                                                <Button x:Name="EntityBrowserBrowsePackageButton"
                                                        Content="Browse package"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserBrowsePackageButton_Click" />
                                                <Button x:Name="EntityBrowserOpenPackageButton"
                                                        Content="Open package in Arkive"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserOpenPackageButton_Click" />
                                                <Button x:Name="EntityBrowserExportAssetButton"
                                                        Content="Export selected"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserExportAssetButton_Click" />
                                                <Button x:Name="EntityBrowserExtractSkeletalMeshAssetKitButton"
                                                        Content="Extract complete asset kit"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserExtractSkeletalMeshAssetKitButton_Click"
                                                        ToolTip="Export this linked SkeletalMesh and its exact material and Texture2D dependencies into one persistent authoring folder." />
                                                <Button x:Name="EntityBrowserStartTextureModButton"
                                                        Content="Start texture mod"
                                                        IsEnabled="False"
                                                        Click="EntityBrowserStartTextureModButton_Click"
                                                        ToolTip="Create or reopen a guided mod project for the selected linked Texture2D." />
                                            </WrapPanel>
                                        </StackPanel>
                                        <DataGrid x:Name="EntityBrowserAssetsGrid"
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserResizeColumns="True"
                                                  SelectionMode="Single"
                                                  SelectionChanged="EntityBrowserAssetsGrid_SelectionChanged"
                                                  MouseDoubleClick="EntityBrowserAssetsGrid_MouseDoubleClick"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="150" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90" />
                                                <DataGridTextColumn Header="Package" Binding="{Binding PackageAlias}" Width="165" />
