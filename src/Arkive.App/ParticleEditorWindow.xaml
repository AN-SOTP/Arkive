<Window x:Class="Arkive.App.ParticleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Arkive particle effect"
        Width="1400"
        Height="860"
        MinWidth="860"
        MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="Browser" />
        <Border x:Name="UnavailablePanel" Visibility="Collapsed" Padding="24" Background="{DynamicResource AppBackgroundBrush}">
            <TextBlock x:Name="UnavailableText" MaxWidth="560" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="1" Padding="10,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save changes" IsEnabled="False" MinWidth="120"
                        Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"
                        ToolTip="Writes these settings into the effect's working copy in this mod. Save the mod and apply it in Mods to see it in game." />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="Reading the effect…" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
