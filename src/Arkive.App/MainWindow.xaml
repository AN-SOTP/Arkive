                                        <DataGridTextColumn Header="Packages" Binding="{Binding PackageCount}" Width="85" />
                                        <DataGridTextColumn Header="Package bytes" Binding="{Binding PackageBytes}" Width="110" />
                                        <DataGridTextColumn Header="Indexed assets" Binding="{Binding IndexedAssets}" Width="105" />
                                        <DataGridTextColumn Header="Backend fingerprint" Binding="{Binding BackendFingerprint}" Width="145" />
                                        <DataGridTextColumn Header="DB fingerprint" Binding="{Binding MetadataFingerprint}" Width="145" />
                                        <DataGridTextColumn Header="Library root" Binding="{Binding LibraryRoot}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          Background="{DynamicResource DividerBrush}" Cursor="SizeNS" />
                            <GroupBox Grid.Row="2" Header="Changes against the current installation (unchanged packages are omitted)" Padding="5">
                                <DataGrid x:Name="ClientSnapshotChangesGrid"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserResizeColumns="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="85" />
                                        <DataGridTextColumn Header="Relative package path" Binding="{Binding RelativePath}" Width="*" />
                                        <DataGridTextColumn Header="Previous size" Binding="{Binding PreviousSize}" Width="110" />
                                        <DataGridTextColumn Header="Current size" Binding="{Binding CurrentSize}" Width="110" />
                                        <DataGridTextColumn Header="Previous modified" Binding="{Binding PreviousModified}" Width="145" />
                                        <DataGridTextColumn Header="Current modified" Binding="{Binding CurrentModified}" Width="145" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GridSplitter Grid.Row="3" Height="7" HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          Background="{DynamicResource DividerBrush}" Cursor="SizeNS" />
                            <GroupBox Grid.Row="4" Header="Lazy package / asset baselines" Padding="5">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                        <Button x:Name="OpenSelectedAssetBaselineButton"
                                                Content="Open selected manifest folder"
                                                IsEnabled="False"
                                                Click="OpenSelectedAssetBaselineButton_Click" />
                                        <Button x:Name="CopySelectedAssetBaselineButton"
                                                Content="Copy hashes and identity"
                                                IsEnabled="False"
                                                Click="CopySelectedAssetBaselineButton_Click" />
                                    </WrapPanel>
                                    <DataGrid x:Name="AssetBaselinesGrid"
                                              IsReadOnly="True"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserResizeColumns="True"
                                              SelectionMode="Single"
                                              SelectionChanged="AssetBaselinesGrid_SelectionChanged"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="145" />
                                            <DataGridTextColumn Header="Decoded package" Binding="{Binding PackageAlias}" Width="175" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Kind}" Width="100" />
                                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="150" />
                                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="210" />
                                            <DataGridTextColumn Header="Logical range" Binding="{Binding LogicalRange}" Width="155" />
                                            <DataGridTextColumn Header="Storage spans" Binding="{Binding StorageSpanCount}" Width="95" />
                                            <DataGridTextColumn Header="Package SHA-256" Binding="{Binding PackageHash}" Width="145" />
                                            <DataGridTextColumn Header="Payload SHA-256" Binding="{Binding PayloadHash}" Width="145" />
                                            <DataGridTextColumn Header="Payload status" Binding="{Binding PayloadStatus}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ModifiedUpksTab" Header="Mods">
                    <DockPanel>
                    <Border x:Name="ModsAdvancedBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="9,5" Margin="6,6,6,0"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button x:Name="ModsAdvancedBackButton" DockPanel.Dock="Left" Content="‹ Back to Mod Library"
                                    Padding="9,2" MinHeight="24" Click="ModsAdvancedBackButton_Click" />
                            <TextBlock x:Name="ModsAdvancedBarText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                    </Border>
                    <TabControl x:Name="ModifiedUpksInnerTabControl" SelectedIndex="0"
                                SelectionChanged="ModifiedUpksInnerTabControl_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem x:Name="ModLibraryTab" Header="Mod Library">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <WrapPanel Margin="0,0,0,7">
                                        <Button x:Name="ModLibraryNewButton" Content="New mod" Click="NewModButton_Click" />
                                        <Button x:Name="ModLibraryImportButton" Content="Import…" Click="ModLibraryImportButton_Click" />
                                        <Button x:Name="ModLibraryNewPackButton" Content="New pack…" Click="ModLibraryNewPackButton_Click"
                                                ToolTip="Group several mods into a pack that turns on and off with one switch." />
                                        <Button x:Name="ModLibraryGameTablesButton" Content="Game tables…" Click="ModLibraryGameTablesButton_Click"
                                                ToolTip="Make a Game Data mod: change cells of the game's tables (item models, NPC name tags, camera blur) or import a .sql patch." />
                                        <Button x:Name="ModLibraryEditButton" Content="Edit mod" Click="ModLibraryEditButton_Click" />
                                        <Button x:Name="ModLibrarySaveButton" Content="Save mod" Click="ModLibrarySaveButton_Click" />
                                        <Button x:Name="ModLibraryExportButton" Content="Share…" Click="ModLibraryExportButton_Click" />
                                        <Button x:Name="ModLibraryPreviewButton" Content="Preview changes" Click="ModLibraryPreviewButton_Click" />
                                        <Button x:Name="ModLibraryApplyButton" Content="Apply changes" Click="ModLibraryApplyButton_Click"
                                                ToolTip="Save pending edits, review the plan, then rebuild and apply the enabled mods." />
                                        <Button x:Name="ModLibraryRestoreAllButton" Content="Restore all game files" Click="ModLibraryRestoreAllButton_Click"
                                                ToolTip="Put the game's original files back while keeping your enabled mod selection. Do this before a game update." />
                                        <Button x:Name="ModLibraryCheckUpdateButton" Content="Check after game update" Click="ModLibraryCheckUpdateButton_Click"
                                                ToolTip="After a game update, find out which mods are ready to apply and which need rebasing. No game file is changed." />
                                        <Button x:Name="ModLibraryRebaseButton" Content="Rebase mods" Visibility="Collapsed" Click="ModLibraryRebaseButton_Click"
                                                ToolTip="Set up the mods the game update changed against the updated game files. No game file is changed until you choose Apply changes." />
                                        <Button Content="More actions" Click="ModLibraryMoreButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="ModLibraryEnableButton" Header="Enable" Click="ModLibraryEnableButton_Click" />
                                                    <MenuItem x:Name="ModLibraryMakeWinnerButton" Header="Make this mod win" Click="ModLibraryMakeWinnerButton_Click" />
                                                    <MenuItem x:Name="ModLibraryPriorityUpButton" Header="Increase priority" Click="ModLibraryPriorityUpButton_Click" />
                                                    <MenuItem x:Name="ModLibraryPriorityDownButton" Header="Decrease priority" Click="ModLibraryPriorityDownButton_Click" />
                                                    <Separator />
                                                    <MenuItem x:Name="ModLibraryPrepareButton" Header="Prepare for editing" Click="ModLibraryPrepareButton_Click" />
                                                    <MenuItem x:Name="ModLibraryEditTablesButton" Header="Edit table changes…" Click="ModLibraryEditTablesButton_Click"
                                                              ToolTip="Add, change or remove the game table cells this mod changes." />
                                                    <MenuItem x:Name="ModLibraryUpdateButton" Header="Update for this game version" Click="ModLibraryUpdateButton_Click" />
                                                    <MenuItem x:Name="ModLibraryGoToPackageButton" Header="Advanced package projects" Click="ModLibraryGoToPackageButton_Click" />
                                                    <MenuItem x:Name="ModLibraryRemoveButton" Header="Delete mod" Click="ModLibraryRemoveButton_Click" />
                                                    <Separator />
                                                    <MenuItem x:Name="ModLibraryRestoreOtherFolderButton" Header="Restore from another Arkive folder…"
                                                              Click="ModLibraryRestoreOtherFolderButton_Click"
                                                              ToolTip="Put back game files that an Arkive using a different data folder installed mods into, from that folder's verified backups." />
                                                    <MenuItem x:Name="ModLibraryCleanUpWorkingFilesButton" Header="Clean up working files…"
                                                              Click="ModLibraryCleanUpWorkingFilesButton_Click"
                                                              ToolTip="Delete edited meshes and game-mesh exports that no draft, mod or package build uses, such as replaced Simple upscale pieces." />
                                                    <MenuItem Header="Open mods folder" Click="ModLibraryOpenFolderButton_Click" />
                                                    <MenuItem x:Name="ModLibraryGameFolderButton" Header="Game folder…" Click="ModLibraryGameFolderButton_Click" />
                                                    <MenuItem x:Name="ModLibraryRefreshButton" Header="Refresh" Click="ModLibraryRefreshButton_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>
                                    <Border x:Name="ModOverlapBanner" Visibility="Collapsed" Padding="9,7" Margin="0,0,0,7"
                                            Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <Button x:Name="ModOverlapHideButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                                                    Padding="9,2" MinHeight="24" Content="Hide" Click="ModOverlapHideButton_Click"
                                                    ToolTip="Hide this warning until the overlapping mods or their winners change." />
                                            <StackPanel>
                                                <TextBlock x:Name="ModOverlapTitleText" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Margin="0,2,0,0"
                                                           Text="Only the winning mod's version of a shared asset goes into the game. The mod with the higher priority wins." />
                                                <ItemsControl x:Name="ModOverlapList" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,5,0,0">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="{Binding MakeWinnerWinLabel}" Visibility="{Binding TiedVisibility}"
                                                                            Padding="9,2" MinHeight="24" Margin="8,0,0,0"
                                                                            Click="ModOverlapMakeWinnerWin_Click" />
                                                                    <Button Content="{Binding MakeOtherWinLabel}" Padding="9,2" MinHeight="24" Margin="8,0,0,0"
                                                                            Click="ModOverlapMakeOtherWin_Click"
                                                                            ToolTip="Give this mod a priority above every enabled mod it overlaps." />
                                                                    <Button Content="Show shared assets" Padding="9,2" MinHeight="24" Margin="8,0,0,0"
                                                                            Click="ModOverlapShow_Click" ToolTip="{Binding ToolTip}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource WarningTextBrush}" ToolTip="{Binding ToolTip}" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="ModOverlapMoreText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="ModLibraryPendingText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,5" />
                                    <TextBlock x:Name="ModLibraryStatusText" TextWrapping="Wrap"
                                               Text="The mod library has not been loaded yet." />
                                    <ProgressBar x:Name="ModLibraryProgressBar" Height="8"
                                                 Minimum="0" Maximum="1" Value="0" Margin="0,7,0,0" />
                                </StackPanel>
                                <Grid x:Name="ModLibraryPaneGrid" SizeChanged="WorkflowPaneGrid_SizeChanged" ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="ModLibraryModsRow" Height="*" MinHeight="120" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition x:Name="ModLibraryDetailsRow" Height="*" MinHeight="140" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="ModLibraryGrid"
                                              IsReadOnly="False" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                                              SelectionMode="Extended" SelectionUnit="FullRow"
                                              SelectionChanged="ModLibraryGrid_SelectionChanged"
                                              CellEditEnding="ModLibraryGrid_CellEditEnding"
                                              PreviewMouseRightButtonDown="ModLibraryGrid_PreviewMouseRightButtonDown"
                                              PreviewKeyDown="ModLibraryGrid_PreviewKeyDown"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu x:Name="ModLibraryRowMenu" Opened="ModLibraryRowMenu_Opened">
                                                <MenuItem x:Name="ModLibraryRowEnableItem" Header="Disable" Click="ModLibraryEnableButton_Click" />
                                                <MenuItem x:Name="ModLibraryRowPriorityUpItem" Header="Increase priority" InputGestureText="Ctrl+Up"
                                                          Click="ModLibraryPriorityUpButton_Click" />
                                                <MenuItem x:Name="ModLibraryRowPriorityDownItem" Header="Decrease priority" InputGestureText="Ctrl+Down"
                                                          Click="ModLibraryPriorityDownButton_Click" />
                                                <MenuItem x:Name="ModLibraryRowRenameItem" Header="Rename" InputGestureText="F2"
                                                          Click="ModLibraryRowRenameItem_Click" />
                                                <MenuItem x:Name="ModLibraryRowAuthorItem" Header="Change author"
                                                          Click="ModLibraryRowAuthorItem_Click" />
                                                <MenuItem x:Name="ModLibraryRowUpdateItem" Header="Update for this game version"
                                                          Click="ModLibraryUpdateButton_Click"
                                                          ToolTip="Set the mod up against your current game files. Changes are kept only if they pass every safety check." />
                                                <Separator />
                                                <MenuItem x:Name="ModLibraryRowAddToPackItem" Header="Add to pack" />
                                                <MenuItem x:Name="ModLibraryRowRemoveFromPackItem" Header="Remove from pack"
                                                          Click="ModLibraryRowRemoveFromPack_Click" />
                                                <Separator />
                                                <MenuItem x:Name="ModLibraryRowDeleteItem" Header="Delete mod" Click="ModLibraryRemoveButton_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <!-- Mods in a pack are listed under the pack's heading: its switch, name, state and any overlap. -->
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <StackPanel>
                                                                        <Border x:Name="PackHeader" Visibility="Collapsed" MinHeight="{DynamicResource RowHeight}"
                                                                                Background="{DynamicResource SurfaceAltBrush}"
                                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
                                                                                ToolTip="A mod pack. Its box turns all of its mods on or off; right-click for more.">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu Opened="ModPackMenu_Opened"
                                                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem x:Name="ModPackTurnOnItem" Header="Turn pack on" Click="ModPackTurnOnItem_Click" />
                                                                                    <MenuItem Header="Edit pack…" Click="ModPackEditItem_Click" />
                                                                                    <MenuItem Header="Make this pack win" Click="ModPackMakeWinItem_Click"
                                                                                              ToolTip="Raise the priority of every mod in the pack so it wins over enabled mods outside it." />
                                                                                    <Separator />
                                                                                    <MenuItem Header="Remove pack (keeps its mods)" Click="ModPackRemoveItem_Click" />
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <DockPanel>
                                                                                <Border Width="45">
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                              IsChecked="{Binding Name.OnState, Mode=OneWay}"
                                                                                              Click="ModPackSwitch_Click"
                                                                                              ToolTip="Turn every mod in this pack on or off. Choose Apply changes to update the game." />
                                                                                </Border>
                                                                                <ToggleButton x:Name="PackToggle" Cursor="Hand" Focusable="False"
                                                                                              IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}" Click="ModPackToggle_Click"
                                                                                              ToolTip="Show or hide the mods in this pack.">
                                                                                    <ToggleButton.Template>
                                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                                                                <TextBlock x:Name="Arrow" Text="▾" Width="16" VerticalAlignment="Center"
                                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                                <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsChecked" Value="False">
                                                                                                    <Setter TargetName="Arrow" Property="Text" Value="▸" />
                                                                                                </Trigger>
                                                                                            </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                    </ToggleButton.Template>
                                                                                </ToggleButton>
                                                                                <TextBlock Text="{Binding Name.Summary}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                <TextBlock Text="{Binding Name.Warning}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource WarningTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <ItemsPresenter x:Name="PackItems" />
                                                                    </StackPanel>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Name.IsPack}" Value="True">
                                                                            <Setter TargetName="PackHeader" Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <Trigger SourceName="PackToggle" Property="IsChecked" Value="False">
                                                                            <Setter TargetName="PackItems" Property="Visibility" Value="Collapsed" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="On" Width="45">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                  Click="ModLibraryEnabledCheckBox_Click"
                                                                  ToolTip="Enable this mod. Choose Apply changes to update the game." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Priority" Width="70" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Priority, Mode=OneWay}" MinWidth="44" Padding="3,0"
                                                                 VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                                                 PreviewKeyDown="ModLibraryPriorityBox_PreviewKeyDown"
                                                                 LostKeyboardFocus="ModLibraryPriorityBox_LostKeyboardFocus"
                                                                 ToolTip="Type a priority and press Enter, or use the Up and Down keys. When two enabled mods change the same asset, the higher priority wins." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- A template column: a bound text column with a one-way binding can never be edited. -->
                                            <DataGridTemplateColumn x:Name="ModLibraryNameColumn" Header="Mod" Width="320" SortMemberPath="DisplayName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Padding="2,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" Loaded="ModLibraryNameBox_Loaded"
                                                                 ToolTip="Type a new name and press Enter, or Escape to keep the old one." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" IsReadOnly="True" />
                                            <DataGridTemplateColumn x:Name="ModLibraryAuthorColumn" Header="Author" Width="120" SortMemberPath="Author">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Author}" VerticalAlignment="Center" Padding="2,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding AuthorText, Mode=OneWay}" Loaded="ModLibraryNameBox_Loaded"
                                                                 ToolTip="Type the author's name and press Enter, or Escape to keep it." />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Assets" Binding="{Binding AssetSummary}" Width="190" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Packages" Binding="{Binding Packages}" Width="180" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="210" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Conflicts" Binding="{Binding Conflicts}" Width="130" IsReadOnly="True" />
                                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GridSplitter x:Name="ModLibraryPaneSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                                  ShowsPreview="True" DragCompleted="WorkflowPaneSplitter_DragCompleted"
                                                  ToolTip="Drag to resize the mod list and asset details. Arrow keys also resize the panes." />
                                    <TabControl Grid.Row="2" x:Name="ModLibraryDetailTabs">
                                        <TabItem Header="Assets">
                                            <DockPanel>
                                                <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                                                    <Button x:Name="ModLibraryEditAssetButton" Content="Edit asset"
                                                            Click="ModLibraryEditAssetButton_Click" />
                                                    <Button x:Name="ModLibraryRemoveAssetButton" Content="Remove selected assets" IsEnabled="False"
                                                            Click="ModLibraryRemoveAssetButton_Click"
                                                            ToolTip="Remove all selected assets. Ctrl-click and Shift-click select several rows; Ctrl+A selects all. Clearing the entire mod opens an empty editing draft so you can add replacements." />
                                                </WrapPanel>
                                                <DataGrid x:Name="ModLibraryAssetsGrid" IsReadOnly="True"
                                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                                          CanUserResizeColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                                          SelectionChanged="ModLibraryAssetsGrid_SelectionChanged"
                                                          MouseDoubleClick="ModLibraryAssetsGrid_MouseDoubleClick"
                                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" />
                                                        <DataGridTextColumn Header="Asset" Binding="{Binding DisplayName}" Width="2*" MinWidth="180" />
                                                        <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="2*" MinWidth="160" />
                                                        <DataGridTextColumn Header="Source UPK" Binding="{Binding Package}" Width="2*" MinWidth="160" />
                                                        <DataGridTextColumn Header="Change" Binding="{Binding Route}" Width="*" MinWidth="110" />
                                                        <DataGridTextColumn Header="Priority result" Binding="{Binding Resolution}" Width="120" />
                                                        <DataGridTextColumn Header="Setup" Binding="{Binding Setup}" Width="*" MinWidth="100" />
                                                        <DataGridTextColumn Header="Game" Binding="{Binding InGame}" Width="85" />
                                                        <DataGridTextColumn Header="Local changes" Binding="{Binding LocalChanges}" Width="*" MinWidth="110" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </TabItem>
                                        <TabItem x:Name="ModLibraryConflictsTab" Header="Conflicts">
                                            <DataGrid x:Name="ModLibraryConflictsGrid" IsReadOnly="True"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Other mod" Binding="{Binding OtherMod}" Width="240" />
                                                    <DataGridTextColumn Header="State" Binding="{Binding OtherState}" Width="85" />
                                                    <DataGridTextColumn Header="Priority" Binding="{Binding OtherPriority}" Width="70" />
                                                    <DataGridTextColumn Header="Shared" Binding="{Binding SharedCount}" Width="65" />
                                                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="280" />
                                                    <DataGridTextColumn Header="Shared assets" Binding="{Binding Objects}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Details">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MaxWidth="640" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                    <TextBox x:Name="ModDetailsNameTextBox" Grid.Column="1" Margin="0,0,0,4" />
                                                    <TextBlock Text="Version" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                    <TextBox x:Name="ModDetailsVersionTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />
                                                    <TextBlock Text="Author" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,4" />
