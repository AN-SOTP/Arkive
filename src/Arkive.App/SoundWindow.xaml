<Window x:Class="Arkive.App.SoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound" Width="720" Height="520"
        Icon="Assets/Arkive.ico"
        MinWidth="560" MinHeight="400"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="SoundNameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SoundDetailText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="Play" Width="70" Click="PlayButton_Click"
                            ToolTip="Play or pause the selected clip (Space)." />
                    <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Width="60" Click="StopButton_Click" />
                    <Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0"
                            IsMoveToPointEnabled="True"
                            PreviewMouseDown="PositionSlider_PreviewMouseDown" PreviewMouseUp="PositionSlider_PreviewMouseUp"
                            ValueChanged="PositionSlider_ValueChanged" ToolTip="Drag or click to jump within the clip." />
                    <TextBlock x:Name="PositionText" Grid.Column="3" Text="0:00 / 0:00" VerticalAlignment="Center" MinWidth="90" />
                    <TextBlock Grid.Column="4" Text="Volume" VerticalAlignment="Center" Margin="10,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Slider x:Name="VolumeSlider" Grid.Column="5" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </Grid>
            </Border>
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="ReplaceButton" Content="Replace with audio file…" Style="{StaticResource PrimaryButtonStyle}"
                        Click="ReplaceButton_Click"
                        ToolTip="Pick a .wav, .mp3, .ogg, .flac, .m4a or .wma file to play in place of the selected clip. Close Lost Ark first." />
                <Button x:Name="RestoreButton" Content="Restore original" Click="RestoreButton_Click"
                        ToolTip="Put the game's own audio back for the selected clip." />
                <Button x:Name="ExportButton" Content="Save as WAV…" Click="ExportButton_Click"
                        ToolTip="Save the selected clip, as the game plays it now, to a .wav file." />
            </WrapPanel>
            <CheckBox x:Name="FitBankCheckBox" Content="Fit sound bank to new length" IsChecked="True" Margin="0,10,0,0"
                      Click="FitBankCheckBox_Click"
                      ToolTip="Music only. The game's sound bank is changed to play your file at its own length and loop it from its end, so a longer song is not cut off and a shorter one loops without silence. Restore puts the game's timing back." />
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid x:Name="ClipsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  SelectionChanged="ClipsGrid_SelectionChanged" MouseDoubleClick="ClipsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Clip" Binding="{Binding Number}" Width="45" />
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80" />
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="2*" MinWidth="170" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="3*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
