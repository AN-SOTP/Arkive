<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Apply parses meshes on many cores at once; the server collector stops them waiting on one another
         (a 476-piece apply went from 6 m 24 s to 4 m 25 s, with less memory). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Arkive.Core/Arkive.Core.csproj" />
    <None Include="../Arkive.Core/runtimes/win-x64/native/Arkive.Crunch.Native.dll"
          Link="Arkive.Crunch.Native.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
