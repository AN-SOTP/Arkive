                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Mod" Binding="{Binding ModColumn}" Width="190" IsReadOnly="True" />
                                            <DataGridTextColumn Header="StaticMesh edit" Binding="{Binding DisplayName}" Width="240" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="240" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Replacement route" Binding="{Binding ImportProfile}" Width="190" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Collision policy" Binding="{Binding Collision}" Width="230" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Project state" Binding="{Binding State}" Width="190" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Edited GLB" Binding="{Binding EditedGlbPath}" Width="*" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Materials">
                                    <DataGrid x:Name="GuidedMaterialModsGrid"
                                              IsReadOnly="False" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserResizeColumns="True"
                                              SelectionMode="Extended" SelectionUnit="FullRow"
                                              SelectionChanged="GuidedMaterialModsGrid_SelectionChanged"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Include" Width="65">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanToggleInclude}"
                                                                  ToolTip="{Binding IncludeToolTip}"
                                                                  ToolTipService.ShowOnDisabled="True"
                                                                  Click="GuidedMaterialIncludeCheckBox_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Mod" Binding="{Binding ModColumn}" Width="190" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Material project" Binding="{Binding DisplayName}" Width="245" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="260" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Parameters" Binding="{Binding Parameters}" Width="165" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="145" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Project state" Binding="{Binding State}" Width="205" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Project folder" Binding="{Binding ProjectPath}" Width="*" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DockPanel>
                        </TabItem>
                        <TabItem x:Name="ModConflictDependencyTab" Header="Conflicts &amp; Dependencies" Visibility="Collapsed">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Border Padding="9,7" Margin="0,0,0,7"
                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                        <TextBlock Text="This view audits every committed Package Project. Blocking conflicts come only from exact physical targets, duplicate native objects, or missing build files. Material, texture, skeleton, and collision rows are dependency evidence—not guessed conflicts."
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel Margin="0,0,0,5">
                                        <Button x:Name="ModGraphRefreshButton" Content="Refresh audit"
                                                Click="ModGraphRefreshButton_Click" />
                                        <Button x:Name="ModGraphGoToPackageButton" Content="Go to package project"
                                                IsEnabled="False" Click="ModGraphGoToPackageButton_Click" />
                                        <Button x:Name="ModGraphCopyButton" Content="Copy report"
                                                IsEnabled="False" Click="ModGraphCopyButton_Click" />
                                        <TextBlock Text="Show" Margin="10,0,5,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ModGraphPackageFilterComboBox" Width="260"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="ModGraphPackageFilterComboBox_SelectionChanged" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ModGraphSummaryText"
                                               Text="The package conflict and dependency graph has not been loaded."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" MinHeight="100" />
                                        <RowDefinition Height="7" />
                                        <RowDefinition Height="*" MinHeight="160" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="ModGraphConflictsGrid" IsReadOnly="True"
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              CanUserResizeColumns="True" SelectionMode="Single"
                                              SelectionChanged="ModGraphGrid_SelectionChanged"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="95" />
                                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                                            <DataGridTextColumn Header="Package" Binding="{Binding PackageAlias}" Width="190" />
                                            <DataGridTextColumn Header="Affected objects" Binding="{Binding Objects}" Width="230" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="280" />
                                            <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch"
                                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                                    <DataGrid Grid.Row="2" x:Name="ModGraphDependenciesGrid" IsReadOnly="True"
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              CanUserResizeColumns="True" SelectionMode="Single"
                                              SelectionChanged="ModGraphGrid_SelectionChanged"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Package" Binding="{Binding PackageAlias}" Width="175" />
                                            <DataGridTextColumn Header="Source kind" Binding="{Binding SourceKind}" Width="105" />
                                            <DataGridTextColumn Header="Source object" Binding="{Binding SourceObject}" Width="220" />
                                            <DataGridTextColumn Header="Relationship" Binding="{Binding Relation}" Width="185" />
                                            <DataGridTextColumn Header="Target kind" Binding="{Binding TargetKind}" Width="110" />
                                            <DataGridTextColumn Header="Target / contract" Binding="{Binding TargetObject}" Width="240" />
                                            <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="205" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="ModSetsTab" Header="Mod Sets" Visibility="Collapsed">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Border Padding="9,7" Margin="0,0,0,7"
                                            Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="A Mod Set installs several independently built UPKs as one named configuration. Arkive preflights every target first, blocks overlapping payloads, and rolls back every package changed by the transaction if any member fails."
                                                   Foreground="{DynamicResource SuccessTextBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel Margin="0,0,0,5">
                                        <TextBlock Text="Set name" VerticalAlignment="Center" Margin="2,0,5,0" />
                                        <TextBox x:Name="ModSetNameTextBox" Width="245" Margin="0,0,8,0" />
                                        <TextBlock Text="Notes" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox x:Name="ModSetNotesTextBox" Width="330" Margin="0,0,8,0" />
                                        <Button Content="Create set" Click="ModSetCreateButton_Click" />
                                        <Button x:Name="ModSetSaveButton" Content="Save" IsEnabled="False"
                                                Click="ModSetSaveButton_Click" />
                                        <Button x:Name="ModSetDeleteButton" Content="Delete set" IsEnabled="False"
                                                Click="ModSetDeleteButton_Click" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,5">
                                        <Button x:Name="ModSetInstallButton" Content="Install checked set" IsEnabled="False"
                                                Click="ModSetInstallButton_Click" />
                                        <Button x:Name="ModSetRestoreButton" Content="Restore checked set" IsEnabled="False"
                                                Click="ModSetRestoreButton_Click" />
                                        <Button Content="Refresh" Click="ModSetRefreshButton_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ModSetStatusText" Text="Create a set, then check the built package projects it should manage."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="155" MinHeight="90" />
                                        <RowDefinition Height="7" />
                                        <RowDefinition Height="*" MinHeight="150" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="ModSetsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserResizeColumns="True"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              SelectionChanged="ModSetsGrid_SelectionChanged"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Set name" Binding="{Binding DisplayName}" Width="260" />
                                            <DataGridTextColumn Header="Packages" Binding="{Binding PackageSummary}" Width="110" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="155" />
                                            <DataGridTextColumn Header="Conflicts" Binding="{Binding ConflictSummary}" Width="230" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Summary}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch"
                                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                                    <TabControl Grid.Row="2">
                                        <TabItem Header="Package Members">
                                            <DataGrid x:Name="ModSetPackagesGrid" IsReadOnly="False" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserResizeColumns="True"
                                                      SelectionMode="Single" SelectionUnit="FullRow"
                                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Include" Width="65">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Click="ModSetPackageIncludeCheckBox_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Package project" Binding="{Binding DisplayName}" Width="240" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Source UPK" Binding="{Binding PackageAlias}" Width="220" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Assets" Binding="{Binding AssetSummary}" Width="115" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Build state" Binding="{Binding State}" Width="190" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Physical target" Binding="{Binding PhysicalPackageName}" Width="*" IsReadOnly="True" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Conflict Report">
                                            <DataGrid x:Name="ModSetConflictsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserResizeColumns="True"
                                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100" />
                                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="160" />
                                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="300" />
                                                    <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="LegacyMeshBundlesTab" Header="Legacy Single-Mesh Bundles" Visibility="Collapsed">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Border Padding="9,7" Margin="0,0,0,7"
                                            Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="Previously prepared standalone SkeletalMesh bundles are retained here for compatibility and diagnostics. New builds should use Package projects, where textures and one or more meshes are composed into one reversible payload."
                                                   Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel Margin="0,0,0,5">
                                        <Button x:Name="ModifiedMeshGoToEditButton"
                                                Content="Go to mesh edit" IsEnabled="False"
                                                Click="ModifiedMeshGoToEditButton_Click" />
                                        <Button x:Name="ModifiedMeshInspectButton"
                                                Content="Inspect modified UPK" IsEnabled="False"
                                                Click="ModifiedMeshInspectButton_Click" />
                                        <Button x:Name="ModifiedMeshInstallButton"
                                                Content="Install mesh mod" IsEnabled="False"
                                                Click="ModifiedMeshInstallButton_Click" />
                                        <Button x:Name="ModifiedMeshRestoreButton"
                                                Content="Restore original" IsEnabled="False"
                                                Click="ModifiedMeshRestoreButton_Click" />
                                        <Button x:Name="ModifiedMeshOpenBundleButton"
                                                Content="Open bundle folder" IsEnabled="False"
                                                Click="ModifiedMeshOpenBundleButton_Click" />
                                        <Button Content="Refresh" Click="ModifiedMeshRefreshButton_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ModifiedMeshStatusText"
                                               Text="Select a prepared mesh package."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <DataGrid x:Name="ModifiedMeshUpksGrid"
                                          IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserResizeColumns="True"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          SelectionChanged="ModifiedMeshUpksGrid_SelectionChanged"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mod name" Binding="{Binding DisplayName}" Width="230" />
                                        <DataGridTextColumn Header="Source UPK" Binding="{Binding PackageAlias}" Width="210" />
                                        <DataGridTextColumn Header="Physical file" Binding="{Binding PhysicalPackageName}" Width="210" />
                                        <DataGridTextColumn Header="Mesh object" Binding="{Binding ObjectName}" Width="240" />
                                        <DataGridTextColumn Header="Build/install state" Binding="{Binding State}" Width="180" />
                                        <DataGridTextColumn Header="Backup" Binding="{Binding BackupState}" Width="105" />
                                        <DataGridTextColumn Header="Conflict / status" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="Modified UPK" Binding="{Binding OutputUpk}" Width="300" />
                                        <DataGridTextColumn Header="Payload" Binding="{Binding PayloadSize}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- Covers the tabs while a mod operation that takes a few seconds or more runs, so nothing is clicked
                 meanwhile and the user can see Arkive is working (see MainWindow.Busy.cs). -->
            <Grid x:Name="BusyOverlay" Grid.Row="0" Visibility="Collapsed" Panel.ZIndex="100"
                  Cursor="Wait" Focusable="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="22,18" MinWidth="360" MaxWidth="560"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="BusyTitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BusyDetailText" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ProgressBar x:Name="BusyProgressBar" Height="8" Margin="0,14,0,0" IsIndeterminate="True" />
                        <TextBlock x:Name="BusyElapsedText" Margin="0,6,0,0" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="ValidationSplitter" Grid.Row="1"
                          Height="7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource DividerBrush}"
                          Cursor="SizeNS"
                          ToolTip="Drag to resize the results and validation tables." />

            <GroupBox x:Name="ValidationPanel" Header="Technical validation" Grid.Row="2" Padding="6">
                <DataGrid x:Name="ValidationGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110" />
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
