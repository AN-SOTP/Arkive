                                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                                                    <DataGridTextColumn Header="Previous export" Binding="{Binding PreviousExport}" Width="105" />
                                                    <DataGridTextColumn Header="Current export" Binding="{Binding CurrentExport}" Width="105" />
                                                    <DataGridTextColumn Header="Expected SHA-256" Binding="{Binding ExpectedHash}" Width="165" />
                                                    <DataGridTextColumn Header="Current SHA-256" Binding="{Binding CurrentHash}" Width="165" />
                                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Message}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Installation Targets">
                                            <DataGrid x:Name="ClientUpdateInstallationsGrid" IsReadOnly="True"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
