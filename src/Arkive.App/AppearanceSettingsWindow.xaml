<Window x:Class="Arkive.App.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arkive settings" Width="650" Height="820"
        Icon="Assets/Arkive.ico"
        MinWidth="500" MinHeight="600"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Appearance and Windows integration. Game files stay unchanged." />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="2" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Colour theme" FontWeight="SemiBold" />
                    <TextBlock Text="System follows Windows." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="Use system setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                    <ComboBoxItem Content="Pure black (high contrast)" Tag="Black" />
                </ComboBox>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Banner artwork" FontWeight="SemiBold" />
                    <TextBlock Text="The artwork also sets Arkive's accent colour."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ComboBox x:Name="BannerArtworkComboBox" Grid.Row="2" Grid.Column="1" />

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Interface density" FontWeight="SemiBold" />
                    <TextBlock Text="Compact shows more rows." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ComboBox x:Name="DensityComboBox" Grid.Row="4" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="Comfortable" Tag="Comfortable" />
                    <ComboBoxItem Content="Compact" Tag="Compact" />
                </ComboBox>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="Technical validation" FontWeight="SemiBold" />
                    <TextBlock Text="The drawer is always available from the status bar." FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <CheckBox x:Name="ShowValidationCheckBox" Grid.Row="6" Grid.Column="1"
                          Content="Show validation drawer on startup" />
                <StackPanel Grid.Row="8">
                    <TextBlock Text="Windows file icon" FontWeight="SemiBold" />
                    <TextBlock Text="Give .arkive files the Lost Ark icon and open them in Arkive."
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="8" Grid.Column="1">
                    <Button x:Name="RegisterFilesButton" Content="Register .arkive files" Margin="0,0,0,6"
                            HorizontalAlignment="Left" Click="RegisterFilesButton_Click" />
                    <TextBlock x:Name="FileAssociationStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Current user only; no administrator access. Double-clicking imports a mod, never installs it." />
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.ColumnSpan="2">
                    <TextBlock x:Name="UpdateVersionText" FontWeight="SemiBold" />
                    <CheckBox x:Name="CheckUpdatesCheckBox" Content="Check for application updates on startup" Margin="0,8,0,8" />
                    <TextBlock Text="Private releases: use your own fine-grained GitHub token with Contents: read-only access to Arkive. Stored only in Windows Credential Manager."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <PasswordBox x:Name="UpdateTokenBox" Margin="0,8,0,4" ToolTip="Leave blank to retain the current token. Never paste someone else's token." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save access token" Click="SaveUpdateToken_Click" />
                        <Button Content="Forget token" Click="ForgetUpdateToken_Click" />
                        <Button Content="Check for updates" Click="CheckUpdates_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save settings" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
