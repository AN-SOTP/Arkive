<Window x:Class="Arkive.App.TextureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arkive Texture Viewer"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Padding="9" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="HintText" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <ScrollViewer DockPanel.Dock="Right" Width="310" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Parts" FontWeight="SemiBold" />
                <TextBlock x:Name="PartsHint" Margin="0,2,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Reading what the game's interface calls each part…" />
                <ListBox x:Name="PartsList" Height="210" DisplayMemberPath="Label" SelectionChanged="PartsList_SelectionChanged" />
                <StackPanel x:Name="EditPanel" Margin="0,12,0,0">
                    <TextBlock Text="Change" FontWeight="SemiBold" />
                    <ComboBox x:Name="SelectionComboBox" Margin="0,4,0,0" SelectionChanged="SelectionComboBox_SelectionChanged">
                        <ComboBoxItem Content="Every colour" Tag="All" IsSelected="True"
                                      ToolTip="Every pixel of the part takes the new colour." />
                        <ComboBoxItem Content="One colour range (gold, say)" Tag="ColourRange"
                                      ToolTip="Only pixels near the chosen hue change; greys and other colours stay as they are." />
                        <ComboBoxItem Content="Light and white areas" Tag="LightAreas"
                                      ToolTip="Only light, nearly white pixels change (white stone, pale highlights). Lower Brightness to darken them." />
                    </ComboBox>
                    <StackPanel x:Name="RangePanel" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Hue" VerticalAlignment="Center" />
                            <Slider x:Name="RangeHueSlider" Grid.Column="1" Minimum="0" Maximum="359" Value="45" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                            <TextBlock x:Name="RangeHueText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center" />
                            <Slider x:Name="RangeWidthSlider" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="90" Value="25" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                            <TextBlock x:Name="RangeWidthText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="RangePreview" Height="14" CornerRadius="3" Margin="0,4,0,0" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" />
                        <ToggleButton x:Name="PickHueButton" Content="Pick the colour from the picture" Margin="0,6,0,0" HorizontalAlignment="Left"
                                      ToolTip="Then click the picture: the hue under the pointer becomes the middle of the range." />
                    </StackPanel>
                    <TextBlock Text="Style" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <ComboBox x:Name="StyleComboBox" Margin="0,4,0,0" SelectionChanged="StyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Tint: new colour, same shading" Tag="Tint" IsSelected="True"
                                      ToolTip="Each changed pixel keeps its own brightness and takes the new colour's hue." />
                        <ComboBoxItem Content="Two-tone: main colour with highlights" Tag="TwoTone"
                                      ToolTip="Repaints the part in the main colour with its shading, and gives its lightest, raised details the highlight colour (white armour with gold trim, say)." />
                    </ComboBox>
                    <TextBlock x:Name="ColourHeading" Text="New colour" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock x:Name="ColourHint" Margin="0,2,0,6" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Each changed pixel takes this colour's hue and keeps its own brightness, as particle colours do." />
                    <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Red" VerticalAlignment="Center" />
                        <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                        <TextBlock x:Name="RedText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Green" VerticalAlignment="Center" />
                        <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="1" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                        <TextBlock x:Name="GreenText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Blue" VerticalAlignment="Center" />
                        <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="1" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                        <TextBlock x:Name="BlueText" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Strength" VerticalAlignment="Center" />
                        <Slider x:Name="StrengthSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                        <TextBlock x:Name="StrengthText" Grid.Row="3" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Text="Brightness" VerticalAlignment="Center" />
                        <Slider x:Name="BrightnessSlider" Grid.Row="4" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                        <TextBlock x:Name="BrightnessText" Grid.Row="4" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="ColourPreview" Height="22" CornerRadius="4" Margin="0,8,0,0" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}" />
                    <StackPanel x:Name="TwoTonePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Highlight colour" FontWeight="SemiBold" />
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="HighlightButton" DockPanel.Dock="Left" Width="56" Height="24" Margin="0,0,8,0"
                                    ToolTip="Choose the highlight colour" Click="HighlightButton_Click" />
                            <WrapPanel x:Name="HighlightSwatchPanel" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Highlights" VerticalAlignment="Center"
                                       ToolTip="How much of the part, from its lightest details down, takes the highlight colour." />
                            <Slider x:Name="HighlightAmountSlider" Grid.Column="1" Minimum="0" Maximum="0.6" Value="0.2" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                            <TextBlock x:Name="HighlightAmountText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Lift darks" VerticalAlignment="Center"
                                       ToolTip="How light the darkest parts become: 0% keeps the original shading, 100% is flat colour." />
                            <Slider x:Name="LiftSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" ValueChanged="Adjustment_ValueChanged" Margin="0,3" />
                            <TextBlock x:Name="LiftText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="ApplyButton" Content="Apply to part" MinWidth="100" Click="ApplyButton_Click" Margin="0,0,6,6"
                                ToolTip="Keep this change on the selected part. You can then pick another part and colour it too." />
                        <Button x:Name="UndoButton" Content="Undo" MinWidth="60" Click="UndoButton_Click" Margin="0,0,6,6" />
                        <Button x:Name="ResetButton" Content="Back to the game's picture" Click="ResetButton_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
                <CheckBox x:Name="ShowOriginalCheckBox" Content="Show the game's picture" Margin="0,8,0,0"
                          Checked="ShowOriginal_Changed" Unchecked="ShowOriginal_Changed" />
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="SaveButton" Content="Save to working file" MinWidth="130" Click="SaveButton_Click" />
                    <Button Content="Close" MinWidth="70" Margin="8,0,0,0" IsCancel="True" Click="CloseButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="ZoomSlider" Width="220" Minimum="0.125" Maximum="8" Value="1" ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock x:Name="ZoomText" Width="52" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Button Content="Fit" MinWidth="50" Click="FitButton_Click" />
                <Button Content="Selected part" Margin="6,0,0,0" Click="ZoomToPartButton_Click" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Rectangle x:Name="Checkerboard" />
                        <Image x:Name="PictureImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseLeftButtonDown="PictureImage_MouseLeftButtonDown" />
                        <Canvas x:Name="Overlay" IsHitTestVisible="False">
                            <Rectangle x:Name="PartHighlight" Stroke="#FFFF3B3B" StrokeThickness="1" StrokeDashArray="3 2"
                                       Fill="#22FF3B3B" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
