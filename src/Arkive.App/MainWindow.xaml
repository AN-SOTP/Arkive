                                            <DataGridTextColumn Header="Format probe" Binding="{Binding FormatState}" Width="155" />
                                            <DataGridTextColumn Header="Assets" Binding="{Binding AssetSummary}" Width="165" />
                                            <DataGridTextColumn Header="Chunk decode" Binding="{Binding ChunkSummary}" Width="120" />
                                            <DataGridTextColumn Header="Result" Binding="{Binding Summary}" Width="*" />
