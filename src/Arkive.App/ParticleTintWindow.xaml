<Window x:Class="Arkive.App.ParticleTintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Particle effect colour"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18,14,18,18">
        <TextBlock x:Name="EffectText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Every colour of the effect takes this hue and keeps its own brightness. Parts drawn only by their texture or material keep their look." />
        <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Red" VerticalAlignment="Center" />
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Channel_ValueChanged" Margin="0,3" />
            <TextBlock x:Name="RedText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Green" VerticalAlignment="Center" />
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Channel_ValueChanged" Margin="0,3" />
            <TextBlock x:Name="GreenText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Blue" VerticalAlignment="Center" />
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Channel_ValueChanged" Margin="0,3" />
            <TextBlock x:Name="BlueText" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="Preview" Height="28" CornerRadius="4" Margin="0,10,0,0" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Use this colour" MinWidth="110" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
