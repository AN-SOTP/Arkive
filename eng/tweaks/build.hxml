# Compiles Arkive's tweak code. Run eng/tweaks/Build-Tweaks.ps1, which also copies the code into Arkive.Core.
-cp src
--macro include('arkive.tweaks')
-D haxeJSON
-D swf-protected
--swf-version 10
# A SWC holds one code block per class, the layout the game's player is known to load.
-D haxe-boot
-D no-flash-override
--swf bin/arkive-tweaks.swc
