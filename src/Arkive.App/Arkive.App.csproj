<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Apply parses meshes on many cores at once; the server collector stops them waiting on one another
         (a 476-piece apply went from 6 m 24 s to 4 m 25 s, with less memory). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/Arkive.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Arkive.Core/Arkive.Core.csproj" />
    <Resource Include="Assets/Banners/*.jpg" />
    <Resource Include="Assets/Tweaks/*.jpg" />
    <Resource Include="Assets/Arkive.ico" />
    <Content Include="Viewer/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../Arkive.Core/runtimes/win-x64/native/Arkive.Crunch.Native.dll" Link="Arkive.Crunch.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>
</Project>
